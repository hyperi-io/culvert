# UDP listener template, rendered at startup: docs/architecture.md.

mode server
tls-server
topology subnet

server ${OPENVPN_UDP_NETWORK} ${OPENVPN_UDP_NETMASK}

proto udp
port ${OPENVPN_UDP_PORT}

dev tun0
dev-type tun

# DCO needs no setting here: docs/performance.md.

# The CNSA 2.0 classical suite: docs/cryptography.md.
tls-version-min 1.3

data-ciphers ${OPENVPN_DATA_CIPHERS}
data-ciphers-fallback AES-256-GCM

auth SHA384

tls-groups SecP384r1MLKEM1024:X25519MLKEM768:secp384r1:X25519

tls-crypt-v2 /etc/vpn/pki/tc.key

ca /etc/vpn/pki/ca.crt
cert /etc/vpn/pki/issued/server.crt
key /etc/vpn/pki/private/server.key
dh none
crl-verify /etc/vpn/pki/crl.pem

sndbuf ${OPENVPN_SNDBUF}
rcvbuf ${OPENVPN_RCVBUF}
push "sndbuf ${OPENVPN_SNDBUF}"
push "rcvbuf ${OPENVPN_RCVBUF}"

tun-mtu ${OPENVPN_TUN_MTU}
tun-mtu-max 1600
mssfix ${OPENVPN_MSSFIX}

keepalive ${OPENVPN_KEEPALIVE_PING} ${OPENVPN_KEEPALIVE_TIMEOUT}

push "persist-key"
push "persist-tun"

# Concurrent connections per client identity (CULVERT_ALLOW_SHARED_CLIENTS)
${OPENVPN_DUPLICATE_CN}

push "dhcp-option DNS ${OPENVPN_DNS1}"
push "dhcp-option DNS ${OPENVPN_DNS2}"

# block-outside-dns is not pushed: a 2.7 client on Linux or macOS rejects the whole push.

client-config-dir /etc/vpn/server/ccd

user nobody
group nogroup

# persist-key is pushed but not set: 2.7 always persists keys and warns when given it.
persist-tun

max-clients ${OPENVPN_MAX_CLIENTS}

remote-cert-tls client

# Disable compression (VORACLE attack vulnerability)
allow-compression no

# Not shipped: mount your own hooks and uncomment all three lines together.
# script-security 2
# client-connect /etc/vpn/scripts/client-connect.sh
# client-disconnect /etc/vpn/scripts/client-disconnect.sh

explicit-exit-notify 1

reneg-sec ${OPENVPN_RENEG_SEC}

status /var/log/vpn/status.log 10
status-version 3
log-append /var/log/vpn/openvpn.log
verb ${OPENVPN_VERB}
mute ${OPENVPN_MUTE}

# A root-only socket, because the management API is unauthenticated. OAuth2 mode replaces this line.
management /run/vpn/management-udp.sock unix
