# Culvert Test Client
# Minimal client for testing VPN connectivity
#
# Build: docker build -f Dockerfile.test-client -t culvert-client .
# Run:   docker run --rm -it --cap-add NET_ADMIN --device /dev/net/tun \
#          -v ./clients:/etc/vpn/clients:ro \
#          culvert-client /etc/vpn/clients/alice-split.ovpn
#
# Base image: Override with --build-arg UBUNTU_VERSION=xx.xx
# Default: 24.04 LTS (pinned for stability, override for testing newer)

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

LABEL maintainer="HyperI <opensource@hyperi.io>"
LABEL description="OpenVPN test client for connectivity validation"

ARG DEBIAN_FRONTEND=noninteractive

# OpenVPN client from the project's signed apt repo. The downloaded keyring must
# carry EXACTLY ONE primary key and its fingerprint must be the pinned one, so
# neither a substituted key nor a second key smuggled in alongside the real one
# can reach /etc/apt/keyrings. Same check as the server image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        lsb-release \
    && mkdir -p /etc/apt/keyrings \
    && curl --proto '=https' --tlsv1.2 -fsSL --max-time 30 \
         https://swupdate.openvpn.net/repos/repo-public.gpg -o /tmp/openvpn-repo.gpg \
    && gpg --show-keys --with-colons /tmp/openvpn-repo.gpg > /tmp/openvpn-repo.keys \
    && [ "$(grep -c '^pub:' /tmp/openvpn-repo.keys)" = "1" ] \
    && [ "$(awk -F: '/^pub:/{p=1;next} /^fpr:/&&p{print $10;exit}' /tmp/openvpn-repo.keys)" \
         = "30EBF4E73CCE63EEE124DD278E6DA8B4E158C569" ] \
    && rm /tmp/openvpn-repo.keys \
    && gpg --dearmor -o /etc/apt/keyrings/openvpn.gpg /tmp/openvpn-repo.gpg \
    && rm /tmp/openvpn-repo.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/openvpn.gpg] https://build.openvpn.net/debian/openvpn/stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/openvpn.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        openvpn \
        iproute2 \
        iputils-ping \
        dnsutils \
        curl \
        procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /etc/vpn

COPY scripts/test-client-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
