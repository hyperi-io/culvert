# HyperI VPN Configuration
# Copy to .env and customise
#
# All configuration uses the HYPERI_VPN_* environment variable prefix.
# See README.md for full documentation.
#
# License: FSL-1.1-ALv2
# Copyright: (c) 2026 HYPERI PTY LIMITED

#===============================================================================
# Protocol Selection
#===============================================================================
# VPN protocol to run. Options: openvpn, wireguard, both
# Default: openvpn
HYPERI_VPN_PROTOCOL="openvpn"

#===============================================================================
# WireGuard Configuration (only when HYPERI_VPN_PROTOCOL includes wireguard)
#===============================================================================
#HYPERI_VPN_WG_PORT="51820"
#HYPERI_VPN_WG_NETWORK="192.168.200.0/24"
#HYPERI_VPN_WG_MTU="1420"
#HYPERI_VPN_WG_PERSISTENT_KEEPALIVE="25"

# DPI Bypass for WireGuard (tunnels UDP over WebSocket/TLS)
# Requires wstunnel binary on both server and client
#HYPERI_VPN_WG_DPI_BYPASS_ENABLED="false"
#HYPERI_VPN_WG_DPI_BYPASS_PORT="4443"

#===============================================================================
# Health Endpoints
#===============================================================================
#HYPERI_VPN_HEALTH_PORT="8080"

#===============================================================================
# Observability
#===============================================================================
#HYPERI_VPN_METRICS_ENABLED="false"
#HYPERI_VPN_METRICS_PORT="9176"

# OTel (primary for dfe-infra deployments)
#HYPERI_VPN_OTEL_ENABLED="false"
#HYPERI_VPN_OTEL_ENDPOINT="http://localhost:4317"
#HYPERI_VPN_OTEL_PROTOCOL="grpc"

#===============================================================================
# Server Identity
#===============================================================================
HYPERI_VPN_SERVER_CN="vpn.example.com"

#===============================================================================
# Multi-Listener Configuration
#===============================================================================
# Three independent listeners for different access scenarios:
#   UDP  - Primary, best performance (default port: 1194)
#   HTTPS - DPI bypass via port 443 (default port: 443)
#   TCP  - Proxy fallback (default port: 1194)
#
# Each listener gets its own:
#   - VPN subnet (clients get IPs from that range)
#   - OAuth2 callback port (9000/9001/9002)
#   - Optional: per-listener OAuth2 enable/disable

# UDP Listener (primary - best performance)
HYPERI_VPN_UDP_ENABLED="true"
HYPERI_VPN_UDP_PORT="1194"
HYPERI_VPN_UDP_NETWORK="192.168.100.0"
HYPERI_VPN_UDP_NETMASK="255.255.255.0"

# HTTPS Listener (DPI bypass via port 443)
HYPERI_VPN_HTTPS_ENABLED="true"
HYPERI_VPN_HTTPS_PORT="443"
HYPERI_VPN_HTTPS_NETWORK="192.168.101.0"
HYPERI_VPN_HTTPS_NETMASK="255.255.255.0"

# TCP Listener (proxy fallback)
HYPERI_VPN_TCP_ENABLED="true"
HYPERI_VPN_TCP_PORT="1194"
HYPERI_VPN_TCP_NETWORK="192.168.102.0"
HYPERI_VPN_TCP_NETMASK="255.255.255.0"

#===============================================================================
# DNS and Routing
#===============================================================================
# DNS servers pushed to clients
HYPERI_VPN_DNS1="1.1.1.1"
HYPERI_VPN_DNS2="1.0.0.1"

# Routing mode
# true = all traffic through VPN (full tunnel)
# false = only VPN network (split tunnel)
HYPERI_VPN_FULL_TUNNEL="false"

# Additional routes to push (comma-separated CIDR)
# Example: 10.1.0.0/16,192.168.1.0/24
HYPERI_VPN_PUSH_ROUTES=""

#===============================================================================
# Performance Tuning
#===============================================================================
# Network profile presets:
#   default  - Fast wired internet (OS auto-tuning, standard MTU, aggressive keepalive)
#   wireless - 4G/mobile optimized (larger buffers, conservative MTU, tolerant keepalive)
HYPERI_VPN_NETWORK_PROFILE="default"

# Individual overrides (optional - profile sets sensible defaults)
# Buffer sizes: 0 = OS auto-tuning, 393216 = 384KB for high-latency
#HYPERI_VPN_SNDBUF=0
#HYPERI_VPN_RCVBUF=0

# MTU: 1500 = standard, 1400 = mobile-safe (avoids fragmentation)
#HYPERI_VPN_TUN_MTU=1500
#HYPERI_VPN_MSSFIX=1450

# Keepalive: ping interval / timeout (seconds)
# default: 10/60 (aggressive), wireless: 30/120 (tolerant of pauses)
#HYPERI_VPN_KEEPALIVE_PING=10
#HYPERI_VPN_KEEPALIVE_TIMEOUT=60

# Server limits
# max-clients: "auto" calculates from CPU/memory (formula: min(cores*64, GB*650, 1000))
# Set explicit number to override auto-calculation
HYPERI_VPN_MAX_CLIENTS="auto"
#HYPERI_VPN_RENEG_SEC=3600

# Logging configuration
# HYPERI_VPN_LOG_MODE: "file" (default), "stdout" (K8s/containers), "both"
# Kubernetes/EKS/Rancher: Use "stdout" for container logging pipelines
HYPERI_VPN_LOG_MODE="file"
#HYPERI_VPN_VERB=3
#HYPERI_VPN_MUTE=20

#===============================================================================
# Prometheus Metrics
#===============================================================================
# Exports OpenVPN metrics for Prometheus scraping
# Uses B4DCATs/openvpn_exporter (https://github.com/B4DCATs/openvpn_exporter)

# Enable/disable metrics endpoint
METRICS_ENABLED="false"

# Metrics port (standard OpenVPN exporter port)
#METRICS_PORT=9176

# IP access control (production security - restrict to monitoring servers)
# Example: "10.0.0.0/8,192.168.1.100,prometheus.local"
#METRICS_ALLOWED_IPS=

#===============================================================================
# Client Download Server
#===============================================================================
# Web interface for employees to download their .ovpn config files via browser.
# Serves files from /etc/vpn/clients (HYPERI_VPN_CLIENTS_PATH mount).
#
# Access: http://<server>:<port>/ to list files, click to download.
#
# Security notes:
# - Currently serves files without authentication (use firewall/VPN to restrict)
# - Future: OAuth2 integration planned (reuse OIDC config)
# - For production, consider putting behind oauth2-proxy or restricting to VPN

# Enable/disable client download server
CLIENT_DOWNLOAD_ENABLED="false"

# HTTP port for client downloads (separate from health check port 8080)
#CLIENT_DOWNLOAD_PORT=8443

#===============================================================================
# Storage Paths (bind mounts for persistence)
#===============================================================================
# These directories MUST persist - they survive container recreation
# Use absolute paths in production

# PKI directory (CA, server certs, client certs, CRL)
HYPERI_VPN_PKI_PATH="./pki"

# Client .ovpn config files
HYPERI_VPN_CLIENTS_PATH="./clients"

# Log files
HYPERI_VPN_LOGS_PATH="./logs"

#===============================================================================
# PKI Mode Configuration
#===============================================================================
# PKI_MODE determines how certificates are managed:
#
#   local    - (Default) Container generates its own CA using Easy-RSA
#              Best for: Docker standalone, development, testing
#
#   external - Use external CA service (production Kubernetes)
#              Requires PKI_EXTERNAL_TYPE to specify the backend
#
# Production deployments should use PKI_MODE=external with one of:
#
#   PRIMARY TARGETS (fully documented below):
#   - aws-pca:       AWS Private CA (EKS deployments)
#   - vault:         HashiCorp Vault / OpenBao PKI engine (on-prem K8s)
#   - cert-manager:  Kubernetes cert-manager with any Issuer (on-prem K8s)
#   - file:          Pre-provisioned certificates mounted to container
#
#   ADDITIONAL CLOUD PROVIDERS (documented below):
#   - azure-keyvault: Azure Key Vault certificates (AKS deployments)
#   - gcp-cas:        Google Cloud Certificate Authority Service (GKE)
#
# All cloud integrations use identity-based authentication:
#   - AWS:   IRSA (IAM Roles for Service Accounts)
#   - Azure: Workload Identity Federation
#   - GCP:   Workload Identity
#   - Vault/OpenBao: Kubernetes Auth
#
# No static credentials are stored - pods receive identity, exchange for certs.

PKI_MODE="local"
#PKI_EXTERNAL_TYPE=""

#-------------------------------------------------------------------------------
# LOCAL PKI Settings (PKI_MODE=local)
#-------------------------------------------------------------------------------
HYPERI_VPN_CA_CN="HyperI VPN CA"

# Key type: ec (ECDSA - recommended) or rsa
HYPERI_VPN_KEY_TYPE="ec"

# For EC: secp384r1 (CNSA 2.0), secp256r1
# For RSA: 4096 (CNSA 2.0), 2048
HYPERI_VPN_KEY_SIZE="secp384r1"

#-------------------------------------------------------------------------------
# AWS Private CA (PKI_EXTERNAL_TYPE=aws-pca)
#-------------------------------------------------------------------------------
# Use with EKS or any AWS deployment.
#
# CREDENTIALS: Use IRSA (IAM Roles for Service Accounts) - no static secrets!
#   - EKS automatically injects AWS_ROLE_ARN and AWS_WEB_IDENTITY_TOKEN_FILE
#   - Container exchanges OIDC token for short-lived STS credentials
#   - Never store AWS credentials in env vars or images
#
# IAM Policy required:
#   {
#     "Effect": "Allow",
#     "Action": [
#       "acm-pca:GetCertificateAuthorityCertificate",
#       "acm-pca:IssueCertificate",
#       "acm-pca:GetCertificate"
#     ],
#     "Resource": "arn:aws:acm-pca:*:*:certificate-authority/*"
#   }
#
# Configuration (credentials handled by IRSA):
#AWS_PCA_ARN=arn:aws:acm-pca:ap-southeast-2:123456789012:certificate-authority/12345678-1234-1234-1234-123456789012
#AWS_PCA_REGION=ap-southeast-2

#-------------------------------------------------------------------------------
# Azure Key Vault Certificates (PKI_EXTERNAL_TYPE=azure-keyvault)
#-------------------------------------------------------------------------------
# Use with AKS or any Azure deployment.
#
# CREDENTIALS: Use Workload Identity Federation - no static secrets!
#   - AKS automatically injects AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_FEDERATED_TOKEN_FILE
#   - Container exchanges OIDC token for Azure AD token
#   - Never store Azure credentials in env vars or images
#
# Prerequisites:
#   1. Create User-Assigned Managed Identity
#   2. Create Federated Credential linking to AKS OIDC issuer
#   3. Grant Key Vault access (Certificate Get, List, Create)
#
# Azure CLI setup:
#   az identity create -n openvpn-identity -g <resource-group>
#   az identity federated-credential create \
#     --name aks-federated \
#     --identity-name openvpn-identity \
#     --resource-group <resource-group> \
#     --issuer <AKS-OIDC-ISSUER-URL> \
#     --subject system:serviceaccount:vpn:openvpn
#   az keyvault set-policy --name <vault-name> \
#     --object-id <identity-principal-id> \
#     --certificate-permissions get list create
#
# Configuration (credentials handled by Workload Identity):
#AZURE_KEYVAULT_URL=https://myvault.vault.azure.net
#AZURE_KEYVAULT_CERT_NAME=openvpn-server

#-------------------------------------------------------------------------------
# Google Cloud Certificate Authority Service (PKI_EXTERNAL_TYPE=gcp-cas)
#-------------------------------------------------------------------------------
# Use with GKE or any GCP deployment.
#
# CREDENTIALS: Use Workload Identity - no static secrets!
#   - GKE automatically injects credentials via metadata server
#   - Container uses Google Application Default Credentials (ADC)
#   - Never store service account keys in env vars or images
#
# Prerequisites:
#   1. Enable GKE Workload Identity on cluster
#   2. Create GCP Service Account with privateca.certificateRequester role
#   3. Bind Kubernetes SA to GCP SA
#
# gcloud setup:
#   gcloud iam service-accounts create openvpn-sa \
#     --project=<project-id>
#   gcloud privateca pools add-iam-policy-binding <pool-name> \
#     --location=<region> \
#     --member="serviceAccount:openvpn-sa@<project-id>.iam.gserviceaccount.com" \
#     --role="roles/privateca.certificateRequester"
#   gcloud iam service-accounts add-iam-policy-binding \
#     openvpn-sa@<project-id>.iam.gserviceaccount.com \
#     --role="roles/iam.workloadIdentityUser" \
#     --member="serviceAccount:<project-id>.svc.id.goog[vpn/openvpn]"
#
# Kubernetes ServiceAccount annotation:
#   iam.gke.io/gcp-service-account: openvpn-sa@<project-id>.iam.gserviceaccount.com
#
# Configuration (credentials handled by Workload Identity):
#GCP_PROJECT_ID=my-project
#GCP_CAS_LOCATION=us-central1
#GCP_CAS_POOL=openvpn-ca-pool
#GCP_CAS_CA=openvpn-ca

#-------------------------------------------------------------------------------
# HashiCorp Vault / OpenBao PKI (PKI_EXTERNAL_TYPE=vault)
#-------------------------------------------------------------------------------
# Works with both HashiCorp Vault and OpenBao (API-compatible fork)
# On-prem Kubernetes: Use OpenBao as your PKI secrets engine
#
# CREDENTIALS: Use Kubernetes Auth - no static secrets!
#   - Pod's ServiceAccount token is auto-mounted at:
#     /var/run/secrets/kubernetes.io/serviceaccount/token
#   - Container exchanges SA token for short-lived Vault token
#   - Never store Vault tokens in env vars or images
#
# Vault/OpenBao side configuration:
#   vault auth enable kubernetes
#   vault write auth/kubernetes/config kubernetes_host="https://kubernetes.default.svc"
#   vault write auth/kubernetes/role/openvpn \
#     bound_service_account_names=openvpn \
#     bound_service_account_namespaces=vpn \
#     policies=openvpn-pki \
#     ttl=1h
#
# Configuration (credentials handled by Kubernetes Auth):
#VAULT_ADDR=https://openbao.platform.svc:8200
#VAULT_AUTH_METHOD=kubernetes          # Use "kubernetes" for K8s, "token" for dev only
#VAULT_AUTH_ROLE=openvpn               # Kubernetes auth role name
#VAULT_PKI_PATH=pki                    # PKI secrets engine path
#VAULT_PKI_ROLE=openvpn-server         # PKI role for issuing certs
#VAULT_CACERT=/etc/vault/ca.crt        # Optional: Vault/OpenBao TLS CA

#-------------------------------------------------------------------------------
# Kubernetes cert-manager (PKI_EXTERNAL_TYPE=cert-manager)
#-------------------------------------------------------------------------------
# cert-manager issues certificates and mounts them to the pod
# Works with any cert-manager Issuer (including Vault Issuer -> OpenBao)
#
# In Kubernetes:
#   1. Create Certificate CR referencing your Issuer
#   2. cert-manager creates Secret with cert/key
#   3. Mount Secret to container at paths below
#
# No additional env vars needed - just mount certs to these paths:
#CERTMANAGER_CA_PATH="/etc/vpn/pki/ca.crt"
#CERTMANAGER_CERT_PATH="/etc/vpn/pki/issued/server.crt"
#CERTMANAGER_KEY_PATH="/etc/vpn/pki/private/server.key"

#-------------------------------------------------------------------------------
# Pre-mounted Certificates (PKI_EXTERNAL_TYPE=file)
#-------------------------------------------------------------------------------
# For externally provisioned certificates (manual, Ansible, etc.)
# Mount certificates to standard PKI paths before container starts:
#   /etc/vpn/pki/ca.crt
#   /etc/vpn/pki/issued/server.crt
#   /etc/vpn/pki/private/server.key
#   /etc/vpn/pki/tc.key (tls-crypt-v2 key)

#===============================================================================
# Secrets Management (for OIDC credentials, etc.)
#===============================================================================
# Use External Secrets Operator (ESO) to inject secrets from external stores.
# ESO syncs secrets into Kubernetes Secrets, which are then mounted to pods.
# This keeps OAUTH2_CLIENT_SECRET and other sensitive values out of git.
#
# ESO supports 20+ backends - use whatever your org already has.
# All examples use identity-based auth (no static credentials).
#
#-------------------------------------------------------------------------------
# AWS Secrets Manager (EKS with IRSA)
#-------------------------------------------------------------------------------
# SecretStore uses IRSA - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       aws:
#         service: SecretsManager
#         region: ap-southeast-2
#         auth:
#           jwt:
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: aws-secrets-manager
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn/oauth2
#           property: client_secret
#
#-------------------------------------------------------------------------------
# Azure Key Vault (AKS with Workload Identity)
#-------------------------------------------------------------------------------
# SecretStore uses Workload Identity - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       azurekv:
#         authType: WorkloadIdentity
#         vaultUrl: https://myvault.vault.azure.net
#         serviceAccountRef:
#           name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: azure-keyvault
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn-oauth2-client-secret
#
#-------------------------------------------------------------------------------
# GCP Secret Manager (GKE with Workload Identity)
#-------------------------------------------------------------------------------
# SecretStore uses Workload Identity - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       gcpsm:
#         projectID: my-project
#         auth:
#           workloadIdentity:
#             clusterLocation: us-central1
#             clusterName: my-cluster
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: gcp-secrets
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn-oauth2-client-secret
#
#-------------------------------------------------------------------------------
# OpenBao / HashiCorp Vault (on-prem with Kubernetes Auth)
#-------------------------------------------------------------------------------
# SecretStore uses Kubernetes Auth - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       vault:
#         server: https://openbao.platform.svc:8200
#         path: secret
#         auth:
#           kubernetes:
#             mountPath: kubernetes
#             role: external-secrets
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: openbao
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: secret/openvpn/oauth2
#           property: client_secret
#
#-------------------------------------------------------------------------------
# Other Supported Backends
#-------------------------------------------------------------------------------
# ESO also supports (all with identity-based auth where available):
#   - Oracle Cloud Vault
#   - IBM Cloud Secrets Manager
#   - Alibaba Cloud KMS
#   - CyberArk Conjur
#   - 1Password Connect
#   - Doppler
#   - Kubernetes Secrets (for migration)
#
# See: https://external-secrets.io/latest/provider/
#
#-------------------------------------------------------------------------------
# Usage in Deployment
#-------------------------------------------------------------------------------
# Reference the synced secret in your deployment:
#   envFrom:
#     - secretRef:
#         name: openvpn-oauth2

#===============================================================================
# OIDC SSO (Certificate + User Authentication)
#===============================================================================
# Authentication flow: Client cert validates device, OIDC validates user
# Users must have BOTH a valid certificate AND authenticate via their IdP
#
# Supported OIDC Providers:
#   - Microsoft Entra ID (Azure AD)
#   - Okta
#   - Google Workspace
#   - Keycloak
#   - Auth0
#   - Any OIDC-compliant identity provider
#
# Per-listener control: You can enable OAuth2 on some listeners and not others.
# For example: HTTPS requires OAuth2, UDP is cert-only for automation.

# Global OAuth2 toggle (default for all listeners if per-listener not set)
OAUTH2_ENABLED="false"

# Per-listener OAuth2 enable/disable (defaults to OAUTH2_ENABLED if not set)
# Set to false to use certificate-only auth on specific listeners
#OAUTH2_UDP_ENABLED=true      # OAuth2 for UDP listener
#OAUTH2_HTTPS_ENABLED=true    # OAuth2 for HTTPS listener
#OAUTH2_TCP_ENABLED=true      # OAuth2 for TCP listener

# OIDC Provider Configuration
# Example issuer URLs:
#   Entra ID: https://login.microsoftonline.com/{tenant-id}/v2.0
#   Okta:     https://{domain}.okta.com
#   Google:   https://accounts.google.com
#   Keycloak: https://{host}/realms/{realm}
#   Auth0:    https://{tenant}.auth0.com/
OAUTH2_ISSUER="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"
OAUTH2_CLIENT_ID="YOUR_CLIENT_ID"
OAUTH2_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# TLS certificate for OAuth2 HTTPS callbacks (REQUIRED when OAuth2 enabled)
# Most OIDC providers require HTTPS redirect URIs
OAUTH2_TLS_CERT="/etc/vpn/tls/cert.pem"
OAUTH2_TLS_KEY="/etc/vpn/tls/key.pem"

# Per-listener OAuth2 callback ports (configurable)
# These must be open on firewall and registered with your IdP
# Default URLs:
#   UDP:   https://<server>:9000/oauth2/callback
#   HTTPS: https://<server>:9001/oauth2/callback
#   TCP:   https://<server>:9002/oauth2/callback
#OAUTH2_UDP_PORT=9000
#OAUTH2_HTTPS_PORT=9001
#OAUTH2_TCP_PORT=9002

# Group-based access control
# Only members of these groups can connect (comma-separated)
# Use your IdP's group identifiers (GUIDs for Entra ID, names for others)
OAUTH2_VALIDATE_GROUPS=""

# Session secret (generate with: openssl rand -hex 16)
OAUTH2_HTTP_SECRET="GENERATE_ME_openssl_rand_hex_16"

# OIDC scopes (standard for most providers)
OAUTH2_SCOPES="openid,profile,email,offline_access"

#===============================================================================
# Container Registry (Optional - private registry mirror)
#===============================================================================
# Set these to pull/push images from a private container registry
# Leave empty to use Docker Hub or local builds

# Registry URL (without protocol)
# Example: registry.example.com/library
#REGISTRY_URL=

# Registry credentials
#REGISTRY_USERNAME=
#REGISTRY_PASSWORD=

# Image tag (default: latest)
#IMAGE_TAG=latest

#===============================================================================
# General
#===============================================================================
TZ="UTC"
