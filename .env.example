# Culvert Configuration
# Copy to .env and customise
#
# All configuration uses the CULVERT_* environment variable prefix.
# See README.md for full documentation.
#
# License: Apache-2.0
# Copyright: (c) 2026 HYPERI PTY LIMITED

#===============================================================================
# Protocol Selection
#===============================================================================
# VPN protocol to run. Options: openvpn, wireguard, both
# Default: openvpn
CULVERT_PROTOCOL="openvpn"

#===============================================================================
# WireGuard Configuration (only when CULVERT_PROTOCOL includes wireguard)
#===============================================================================
#CULVERT_WG_PORT="51820"
#CULVERT_WG_NETWORK="10.8.3.0/24"
#CULVERT_WG_MTU="1420"
#CULVERT_WG_PERSISTENT_KEEPALIVE="25"

# WireGuard over HTTPS: carries the UDP tunnel inside WebSocket/TLS on a web
# port, for networks that only pass HTTPS (tight corporate egress, hotel and
# conference wifi, captive portals, or a network that blocks VPN protocols).
# Requires the wstunnel binary on both server and client.
#CULVERT_WG_HTTPS_TUNNEL_ENABLED="false"
#CULVERT_WG_HTTPS_TUNNEL_PORT="4443"

#===============================================================================
# Observability
#===============================================================================
# ONE listener (:9090) always serves the health probes (/livez, /readyz)
# and adds Prometheus /metrics when metrics are enabled. Those three paths
# are the whole surface - there are no aliases.
#CULVERT_METRICS_ADDR="0.0.0.0:9090"
#CULVERT_METRICS_ENABLED="false"

# OTel (optional OTLP push; Prometheus scrape always available)
#CULVERT_OTEL_ENABLED="false"
#CULVERT_OTEL_ENDPOINT="http://localhost:4317"
#CULVERT_OTEL_PROTOCOL="grpc"

#===============================================================================
# Server Identity
#===============================================================================
CULVERT_SERVER_CN="vpn.example.com"

#===============================================================================
# Multi-Listener Configuration
#===============================================================================
# Default is the simplest useful server: OpenVPN UDP only. TCP and HTTPS are
# opt-in -- enable them as needed. Each listener uses a distinct subnet, so any
# combination (and WireGuard alongside) can be enabled without collision.
#
# Tunnel subnets live in 10.8.0.0/22, one /24 per listener. Home LANs
# (192.168.x) never collide; check the /22 against your own addressing plan
# and override if it does. See docs/ADDRESSING.md.
#   UDP  - Primary, best performance (default port: 1194) -- ON by default
#   TCP  - Proxy fallback (default port: 1194)             -- opt-in
#   HTTPS - OpenVPN inside TLS on 443 (default port: 443)  -- opt-in
#
# Each listener gets its own:
#   - VPN subnet (clients get IPs from that range)
#   - OAuth2 callback port (9000/9001/9002)
#   - Optional: per-listener OAuth2 enable/disable

# UDP Listener (primary - best performance; the default)
CULVERT_UDP_ENABLED="true"
CULVERT_UDP_PORT="1194"
CULVERT_UDP_NETWORK="10.8.0.0"
CULVERT_UDP_NETMASK="255.255.255.0"

# HTTPS Listener: OpenVPN wrapped in TLS on port 443 -- opt-in
CULVERT_HTTPS_ENABLED="false"
CULVERT_HTTPS_PORT="443"
CULVERT_HTTPS_NETWORK="10.8.2.0"
CULVERT_HTTPS_NETMASK="255.255.255.0"
# Internal port stunnel forwards decrypted traffic to (localhost only)
#CULVERT_HTTPS_INTERNAL_PORT=1195
# TLS certificate + key for the HTTPS-tunnelled listeners. REQUIRED when
# CULVERT_HTTPS_ENABLED=true or CULVERT_WG_HTTPS_TUNNEL_ENABLED=true.
# Use a real cert for the server name (Let's Encrypt). A self-signed cert
# still works for clients that trust it, but it stands out on a network that
# inspects certificates, which defeats the point of using a web port.
#CULVERT_STUNNEL_CERT="/etc/vpn/tls/fullchain.pem"
#CULVERT_STUNNEL_KEY="/etc/vpn/tls/privkey.pem"

# TCP Listener (proxy fallback) -- opt-in
CULVERT_TCP_ENABLED="false"
CULVERT_TCP_PORT="1194"
CULVERT_TCP_NETWORK="10.8.1.0"
CULVERT_TCP_NETMASK="255.255.255.0"

#===============================================================================
# DNS and Routing
#===============================================================================
# DNS servers pushed to clients
CULVERT_DNS1="1.1.1.1"
CULVERT_DNS2="1.0.0.1"

# Routing mode
# true = all traffic through VPN (full tunnel)
# false = only VPN network (split tunnel)
CULVERT_FULL_TUNNEL="false"

# Additional routes to push (comma-separated CIDR)
# Example: 10.1.0.0/16,192.168.1.0/24
CULVERT_PUSH_ROUTES=""

#===============================================================================
# Routing Control (opt-in FORWARD filtering)
#===============================================================================
# When enabled, the container installs a dedicated iptables chain:
#   - replies to established flows always pass;
#   - clients cannot reach each other (CULVERT_CLIENT_ISOLATION=false to
#     allow);
#   - nothing may INITIATE into the tunnels except sources listed in
#     CULVERT_DOWNSTREAM_ADMIN_CIDRS (the edge-fleet reverse-admin path:
#     admin networks reach back down established client tunnels);
#   - if CULVERT_ALLOWED_DESTINATIONS is set, clients may only initiate
#     to those CIDRs (pair it with CULVERT_PUSH_ROUTES so clients are
#     routed at exactly what they are allowed to reach).
# IPv4 only: the tunnels carry IPv4 and the server enables only
# net.ipv4.ip_forward, so these controls are enforced with iptables. Do
# NOT hand-enable IPv6 forwarding on the tunnels - it would bypass them.
#CULVERT_ROUTING_CONTROL_ENABLED="false"
#CULVERT_CLIENT_ISOLATION="true"
#CULVERT_ALLOWED_DESTINATIONS=""
#CULVERT_DOWNSTREAM_ADMIN_CIDRS=""

#===============================================================================
# Performance Tuning
#===============================================================================
# Network profile presets:
#   default  - Fast wired internet (OS auto-tuning, standard MTU, aggressive keepalive)
#   wireless - 4G/mobile optimized (larger buffers, conservative MTU, tolerant keepalive)
CULVERT_NETWORK_PROFILE="default"

# Individual overrides (optional - profile sets sensible defaults)
# Buffer sizes: 0 = OS auto-tuning, 393216 = 384KB for high-latency
#CULVERT_SNDBUF=0
#CULVERT_RCVBUF=0

# MTU: 1500 = standard, 1400 = mobile-safe (avoids fragmentation)
#CULVERT_TUN_MTU=1500
#CULVERT_MSSFIX=1450

# Keepalive: ping interval / timeout (seconds)
# default: 10/60 (aggressive), wireless: 30/120 (tolerant of pauses)
#CULVERT_KEEPALIVE_PING=10
#CULVERT_KEEPALIVE_TIMEOUT=60

# Server limits
# max-clients: "auto" calculates from CPU/memory (formula: min(cores*64, GB*650, 1000))
# Set explicit number to override auto-calculation
CULVERT_MAX_CLIENTS="auto"
#CULVERT_RENEG_SEC=3600

# Logging configuration
# CULVERT_LOG_MODE: "file" (default), "stdout" (K8s/containers), "both"
# Kubernetes/EKS/Rancher: Use "stdout" for container logging pipelines
CULVERT_LOG_MODE="file"
#CULVERT_VERB=3
#CULVERT_MUTE=20

#===============================================================================
# Client Download Server
#===============================================================================
# Web interface for employees to download their .ovpn config files via browser.
# Serves files from /etc/vpn/clients (CULVERT_CLIENTS_PATH mount).
#
# FAILS CLOSED: the served configs embed client private keys, so the server
# refuses to start without a bearer token. Clients send
# "Authorization: Bearer <token>" (browsers: use a download tool or curl).
#
# Access: https://<server>:<port>/ to list files (with the token).

# Enable/disable client download server
CULVERT_CLIENT_DOWNLOAD_ENABLED="false"

# Bearer token - REQUIRED when enabled (generate: openssl rand -hex 32)
#CULVERT_CLIENT_DOWNLOAD_TOKEN=

# HTTP port for client downloads (separate from the observability port)
#CULVERT_CLIENT_DOWNLOAD_PORT=8443

# Bind address - loopback by default; set 0.0.0.0 to serve off-box
#CULVERT_CLIENT_DOWNLOAD_BIND=127.0.0.1

# Optional TLS pair - when set, the listener serves HTTPS
#CULVERT_CLIENT_DOWNLOAD_TLS_CERT=
#CULVERT_CLIENT_DOWNLOAD_TLS_KEY=

#===============================================================================
# Storage Paths (bind mounts for persistence)
#===============================================================================
# These directories MUST persist - they survive container recreation
# Use absolute paths in production

# PKI directory (CA, server certs, client certs, CRL)
CULVERT_PKI_PATH="./pki"

# Client .ovpn config files
CULVERT_CLIENTS_PATH="./clients"

# Log files
CULVERT_LOGS_PATH="./logs"

#===============================================================================
# PKI Mode Configuration
#===============================================================================
# CULVERT_PKI_MODE determines how server certificates are managed:
#
#   local    - (Default) Container generates its own CA using Easy-RSA.
#              Best for: Docker standalone, development, testing.
#
#   external - Fetch CA/server cert/key (and optionally the CRL) from an
#              external secrets backend via CULVERT_SECRETS_PROVIDER.
#              Best for: production Kubernetes with enterprise PKI.

CULVERT_PKI_MODE="local"

#-------------------------------------------------------------------------------
# LOCAL PKI Settings (CULVERT_PKI_MODE=local)
#-------------------------------------------------------------------------------
# Name your organisation and the CA name follows: "Acme" -> "Acme VPN CA".
# Left unset, the CA is just "VPN CA".
#CULVERT_ORG_NAME="Acme"

# Set this only to name the CA outright. It OVERRIDES the CULVERT_ORG_NAME
# derivation above, so leave it commented if you are using ORG_NAME.
#CULVERT_CA_CN="Culvert CA"

# Key type: ec (ECDSA - recommended) or rsa
CULVERT_KEY_TYPE="ec"

# For EC: secp384r1 (CNSA 2.0), secp256r1
# For RSA: 4096 (CNSA 2.0), 2048
CULVERT_KEY_SIZE="secp384r1"

#-------------------------------------------------------------------------------
# EXTERNAL PKI Settings (CULVERT_PKI_MODE=external)
#-------------------------------------------------------------------------------
# Implemented providers (see README "External PKI"):
#
#   file    - certs pre-mounted into the container (K8s Secret volumes,
#             cert-manager-issued Secrets, Ansible, manual provisioning).
#             The CULVERT_SECRETS_*_PATH values are file paths.
#   openbao - OpenBao / HashiCorp-Vault-compatible KV secrets engine.
#             The CULVERT_SECRETS_*_PATH values are secret references.
#   aws     - AWS Secrets Manager (use IRSA on EKS - the pod exchanges its
#             identity for short-lived credentials; no static AWS keys).
#             The CULVERT_SECRETS_*_PATH values are secret ids.
#
# Required when external:
#CULVERT_SECRETS_PROVIDER=file
#CULVERT_SECRETS_CA_CERT_PATH=/etc/vpn/pki/ca.crt
#CULVERT_SECRETS_SERVER_CERT_PATH=/etc/vpn/pki/issued/server.crt
#CULVERT_SECRETS_SERVER_KEY_PATH=/etc/vpn/pki/private/server.key
# Optional CRL source:
#CULVERT_SECRETS_CRL_PATH=
# The tls-crypt-v2 server key. Left unset, each server mints its own, and a
# client config then only works against the server that issued it. Set this to
# share one key when you run MORE THAN ONE server behind a single address.
#CULVERT_SECRETS_TC_KEY_PATH=

# OpenBao / Vault-compatible provider settings
# Kubernetes auth exchanges the pod ServiceAccount token for a short-lived
# Bao token (no static token in env); token auth is for dev only.
#CULVERT_SECRETS_OPENBAO_ADDRESS=https://openbao.platform.svc:8200
#CULVERT_SECRETS_OPENBAO_AUTH_METHOD=kubernetes   # kubernetes | token
#CULVERT_SECRETS_OPENBAO_ROLE=culvert             # required for kubernetes auth
#CULVERT_SECRETS_OPENBAO_TOKEN=                   # token auth (dev) only

# AWS provider settings (credentials via IRSA / instance role)
#CULVERT_SECRETS_AWS_REGION=ap-southeast-2

#===============================================================================
# Secrets Management (for OIDC credentials, etc.)
#===============================================================================
# Use External Secrets Operator (ESO) to inject secrets from external stores.
# ESO syncs secrets into Kubernetes Secrets, which are then mounted to pods.
# This keeps CULVERT_OAUTH2_CLIENT_SECRET and other sensitive values out of git.
#
# ESO supports 20+ backends - use whatever your org already has.
# All examples use identity-based auth (no static credentials).
#
#-------------------------------------------------------------------------------
# AWS Secrets Manager (EKS with IRSA)
#-------------------------------------------------------------------------------
# SecretStore uses IRSA - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       aws:
#         service: SecretsManager
#         region: ap-southeast-2
#         auth:
#           jwt:
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: aws-secrets-manager
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: CULVERT_OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn/oauth2
#           property: client_secret
#
#-------------------------------------------------------------------------------
# Azure Key Vault (AKS with Workload Identity)
#-------------------------------------------------------------------------------
# SecretStore uses Workload Identity - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       azurekv:
#         authType: WorkloadIdentity
#         vaultUrl: https://myvault.vault.azure.net
#         serviceAccountRef:
#           name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: azure-keyvault
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: CULVERT_OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn-oauth2-client-secret
#
#-------------------------------------------------------------------------------
# GCP Secret Manager (GKE with Workload Identity)
#-------------------------------------------------------------------------------
# SecretStore uses Workload Identity - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       gcpsm:
#         projectID: my-project
#         auth:
#           workloadIdentity:
#             clusterLocation: us-central1
#             clusterName: my-cluster
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: gcp-secrets
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: CULVERT_OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: openvpn-oauth2-client-secret
#
#-------------------------------------------------------------------------------
# OpenBao / HashiCorp Vault (on-prem with Kubernetes Auth)
#-------------------------------------------------------------------------------
# SecretStore uses Kubernetes Auth - no static credentials needed:
#   apiVersion: external-secrets.io/v1beta1
#   kind: SecretStore
#   spec:
#     provider:
#       vault:
#         server: https://openbao.platform.svc:8200
#         path: secret
#         auth:
#           kubernetes:
#             mountPath: kubernetes
#             role: external-secrets
#             serviceAccountRef:
#               name: external-secrets-sa
#
# ExternalSecret:
#   apiVersion: external-secrets.io/v1beta1
#   kind: ExternalSecret
#   spec:
#     secretStoreRef:
#       name: openbao
#     target:
#       name: openvpn-oauth2
#     data:
#       - secretKey: CULVERT_OAUTH2_CLIENT_SECRET
#         remoteRef:
#           key: secret/openvpn/oauth2
#           property: client_secret
#
#-------------------------------------------------------------------------------
# Other Supported Backends
#-------------------------------------------------------------------------------
# ESO also supports (all with identity-based auth where available):
#   - Oracle Cloud Vault
#   - IBM Cloud Secrets Manager
#   - Alibaba Cloud KMS
#   - CyberArk Conjur
#   - 1Password Connect
#   - Doppler
#   - Kubernetes Secrets (for migration)
#
# See: https://external-secrets.io/latest/provider/
#
#-------------------------------------------------------------------------------
# Usage in Deployment
#-------------------------------------------------------------------------------
# Reference the synced secret in your deployment:
#   envFrom:
#     - secretRef:
#         name: openvpn-oauth2

#===============================================================================
# OIDC SSO (Certificate + User Authentication)
#===============================================================================
# Authentication flow: Client cert validates device, OIDC validates user
# Users must have BOTH a valid certificate AND authenticate via their IdP
#
# Supported OIDC Providers:
#   - Microsoft Entra ID (Azure AD)
#   - Okta
#   - Google Workspace
#   - Keycloak
#   - Auth0
#   - Any OIDC-compliant identity provider
#
# Per-listener control: You can enable OAuth2 on some listeners and not others.
# For example: HTTPS requires OAuth2, UDP is cert-only for automation.

# Global OAuth2 toggle (default for all listeners if per-listener not set)
CULVERT_OAUTH2_ENABLED="false"

# Per-listener OAuth2 enable/disable (defaults to CULVERT_OAUTH2_ENABLED if not set)
# Set to false to use certificate-only auth on specific listeners
#CULVERT_OAUTH2_UDP_ENABLED=true      # OAuth2 for UDP listener
#CULVERT_OAUTH2_HTTPS_ENABLED=true    # OAuth2 for HTTPS listener
#CULVERT_OAUTH2_TCP_ENABLED=true      # OAuth2 for TCP listener

# OIDC Provider Configuration
# Example issuer URLs:
#   Entra ID: https://login.microsoftonline.com/{tenant-id}/v2.0
#   Okta:     https://{domain}.okta.com
#   Google:   https://accounts.google.com
#   Keycloak: https://{host}/realms/{realm}
#   Auth0:    https://{tenant}.auth0.com/
CULVERT_OAUTH2_ISSUER="https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0"
CULVERT_OAUTH2_CLIENT_ID="YOUR_CLIENT_ID"
CULVERT_OAUTH2_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# TLS certificate for OAuth2 HTTPS callbacks (REQUIRED when OAuth2 enabled)
# Most OIDC providers require HTTPS redirect URIs. Paths are inside the
# container - the compose file mounts OAUTH2_TLS_CERT_PATH there.
CULVERT_OAUTH2_TLS_CERT="/etc/openvpn/oauth2-tls/fullchain.pem"
CULVERT_OAUTH2_TLS_KEY="/etc/openvpn/oauth2-tls/privkey.pem"

# Per-listener OAuth2 callback ports (configurable)
# These must be open on firewall and registered with your IdP
# Default URLs:
#   UDP:   https://<server>:9000/oauth2/callback
#   HTTPS: https://<server>:9001/oauth2/callback
#   TCP:   https://<server>:9002/oauth2/callback
#CULVERT_OAUTH2_UDP_PORT=9000
#CULVERT_OAUTH2_HTTPS_PORT=9001
#CULVERT_OAUTH2_TCP_PORT=9002

# Group-based access control
# Only members of these groups can connect (comma-separated)
# Use your IdP's group identifiers (GUIDs for Entra ID, names for others)
CULVERT_OAUTH2_VALIDATE_GROUPS=""

# Session secret (generate with: openssl rand -hex 16)
CULVERT_OAUTH2_HTTP_SECRET="GENERATE_ME_openssl_rand_hex_16"

# OIDC scopes. Default matches the code (openid,profile,email). Add
# offline_access for IdPs that issue refresh tokens through it (e.g.
# Entra ID); some IdPs reject unknown scopes, so it is not the default.
CULVERT_OAUTH2_SCOPES="openid,profile,email"

#===============================================================================
# Container Registry (Optional - private registry mirror)
#===============================================================================
# Set these to pull/push images from a private container registry
# Leave empty to use Docker Hub or local builds

# Registry URL (without protocol)
# Example: registry.example.com/library
#REGISTRY_URL=

# Registry credentials
#REGISTRY_USERNAME=
#REGISTRY_PASSWORD=

# Image tag (default: latest)
#IMAGE_TAG=latest

#===============================================================================
# General
#===============================================================================
TZ="UTC"
