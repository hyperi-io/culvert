# Culvert Kubernetes test configuration
#
# Copy to tests/k8s/.env (gitignored) and fill in for YOUR cluster. Nothing in
# this file is real - it must not be, because this one IS committed. Keep every
# address, hostname, account and secret in the untracked copy.
#
# With no .env present, every test under tests/k8s/ skips with a message.
# These tests never run in CI.

# Kube context to install into. REQUIRED.
CULVERT_K8S_CONTEXT="my-cluster"

# Namespace for the test release. Created and deleted by the tests.
# Must permit a privileged pod (NET_ADMIN, /dev/net/tun, root).
CULVERT_K8S_NAMESPACE="culvert-test"

# The DNS name clients would dial. REQUIRED.
CULVERT_K8S_SERVER_CN="vpn.example.com"

# Image to deploy. SET THIS - do not rely on the chart default. The default
# covers the server deployment only, while the client pod that dials the tunnel
# needs an explicit reference, so leaving this unset does not fall back: it
# SKIPS the six connectivity tests, which are the ones worth running. A run that
# reports "19 passed, 6 skipped" has not tested a tunnel at all.
#
# PIN A PUBLISHED VERSION rather than a moving tag. A moving tag pointing at a
# hand-built image looks identical to a fresh one: this file pointed at an
# internal registry's `k8stest` tag for days, and every run silently tested an
# image built before three releases of fixes.
CULVERT_K8S_IMAGE="ghcr.io/hyperi-io/culvert:v2.1.10"

# Name of a pre-created image pull secret in the test namespace. Not needed for
# the GHCR package, which is public - only for a private registry.
#CULVERT_K8S_PULL_SECRET="ghcr-pull"

# Which protocols the server under test runs: openvpn | wireguard | both.
# "both" covers the WireGuard path as well and is what the full suite expects.
CULVERT_K8S_PROTOCOL="both"

# Cluster pod CIDR, pushed to clients as a route. REQUIRED for the SPLIT-tunnel
# tests: a split client only routes what the server pushes, so without this it
# reaches the target pod off-tunnel and the target's NetworkPolicy drops it.
# Find it with: kubectl get nodes -o jsonpath='{.items[*].spec.podCIDR}'
#CULVERT_K8S_POD_CIDR="10.42.0.0/16"

# Set true ONLY if the kubelet runs with
# --allowed-unsafe-sysctls=net.ipv4.ip_forward. Otherwise leave it false and the
# privileged init container in docs/use-case-kubernetes.md sets ip_forward inside
# the pod's network namespace instead. The server container cannot do it itself
# at any capability level: /proc/sys is mounted read-only in a container. Check
# the kubelet with:
#   kubectl get --raw /api/v1/nodes/<node>/proxy/configz | grep -i unsafe
CULVERT_K8S_ALLOW_UNSAFE_SYSCTLS="false"

# StorageClass for the PKI claim. The chart renders a claim by default, which
# stays Pending on a cluster with no default StorageClass. Left unset, the tests
# swap it for an emptyDir, so the PKI does not survive a pod restart.
#CULVERT_K8S_STORAGE_CLASS="standard"

# Chart under test. Left unset, the tests install the published chart at the
# version in the VERSION file. Set these to test another version, or a chart
# directory that is not published yet.
#CULVERT_K8S_CHART="oci://ghcr.io/hyperi-io/charts/culvert"
#CULVERT_K8S_CHART_VERSION="X.Y.Z"
