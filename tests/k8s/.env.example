# Culvert Kubernetes test configuration
#
# Copy to tests/k8s/.env (gitignored) and fill in for YOUR cluster. Nothing in
# this file is real - it must not be, because this one IS committed. Keep every
# address, hostname, account and secret in the untracked copy.
#
# With no .env present, every test under tests/k8s/ skips with a message.
# These tests never run in CI.

# Kube context to install into. REQUIRED.
CULVERT_K8S_CONTEXT="my-cluster"

# Namespace for the test release. Created and deleted by the tests.
# Must permit a privileged pod (NET_ADMIN, /dev/net/tun, root).
CULVERT_K8S_NAMESPACE="culvert-test"

# The DNS name clients would dial. REQUIRED.
CULVERT_K8S_SERVER_CN="vpn.example.com"

# Image to deploy. Omit to use the chart default (ghcr.io/hyperi-io/culvert at
# the chart's appVersion). Set it while the package is private, or to test a
# locally built tag pushed to a registry the cluster can reach.
#CULVERT_K8S_IMAGE="ghcr.io/hyperi-io/culvert:v2.1.3"

# Name of a pre-created image pull secret in the test namespace. Needed while
# the GHCR package is private.
#CULVERT_K8S_PULL_SECRET="ghcr-pull"

# Set true ONLY if the kubelet runs with
# --allowed-unsafe-sysctls=net.ipv4.ip_forward. Otherwise the tests drop the
# chart's sysctl request and let the entrypoint set ip_forward at runtime,
# which it can because it holds NET_ADMIN. Check with:
#   kubectl get --raw /api/v1/nodes/<node>/proxy/configz | grep -i unsafe
CULVERT_K8S_ALLOW_UNSAFE_SYSCTLS="false"

# LoadBalancer tests. Leave unset to skip them.
#   _LB_SOURCE_RANGES - CIDRs allowed to reach the LB. The chart's k8s-scale
#     starter ships an invalid placeholder so an unrestricted LB cannot be
#     created by accident; this is what replaces it.
#   _LB_IP - pin the address rather than letting the LB controller choose, so a
#     test cannot take an address something else wants.
#   _LB_CLIENT_HOST - a host OUTSIDE the cluster that can reach the LB, used to
#     prove a real client connects through it. Needs ssh access and docker.
#CULVERT_K8S_LB_SOURCE_RANGES="192.0.2.0/24"
#CULVERT_K8S_LB_IP="192.0.2.10"
#CULVERT_K8S_LB_CLIENT_HOST="testhost.example.com"
