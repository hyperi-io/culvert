# E2E Test Configuration
# Copy this to config.env and fill in your values
#
# Tests run against a SEPARATE test VM, not production!

#===============================================================================
# VPN Server (Test VM)
#===============================================================================
# The test VPN server hostname
E2E_VPN_HOST="your-vpn.example.com"

# VPN ports
E2E_VPN_UDP_PORT="1194"
E2E_VPN_TCP_PORT="443"

# OAuth2 port (if testing OIDC)
E2E_OAUTH2_PORT="9000"

# VPN network assigned to clients
E2E_VPN_NETWORK="10.8.0.0/24"
E2E_VPN_GATEWAY="10.8.0.1"

#===============================================================================
# SSH Access to Test VM
#===============================================================================
# SSH credentials for managing the test VM
E2E_SSH_USER="root"
# E2E_SSH_KEY="/path/to/ssh/key"  # Optional, uses ssh-agent if not set

#===============================================================================
# Internal Network Testing
#===============================================================================
# Internal network accessible via VPN (adjust to match your deployment)
E2E_INTERNAL_NETWORK="10.0.0.0/24"

# Internal gateway host (for connectivity testing via VPN)
E2E_INTERNAL_GATEWAY="10.0.0.1"

# Additional internal host for testing (optional)
# E2E_INTERNAL_TEST_HOST="10.0.0.100"

#===============================================================================
# Test Client Storage
#===============================================================================
# Where to store downloaded test client configs
E2E_TEST_CLIENT_DIR="/tmp/openvpn-e2e-test"

#===============================================================================
# Timeouts
#===============================================================================
# VPN connection timeout (seconds)
E2E_VPN_CONNECT_TIMEOUT="30"

# SSH command timeout (seconds)
E2E_SSH_TIMEOUT="10"
